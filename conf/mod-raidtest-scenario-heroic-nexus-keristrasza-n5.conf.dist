# 魔枢（The Nexus，map 576）英雄：凯利丝塔萨(26723)，**完整进度链路**。
# 2026-09-11 改为链式。装备档位 normal5-v1（ilvl 上限 187），boss 英雄，BotCheats 为空。
#
# 她默认带 UNIT_FLAG_NON_ATTACKABLE + 冰冻牢笼(47854)，解除条件是
# DATA_TELESTRA_ORB(5)/ANOMALUS_ORB(6)/ORMOROK_ORB(7) 全为 DONE
# （boss_keristrasza.cpp 的 CanRemovePrison）。这三个状态只能由**使用三个封印球体**置位。
#
# 本轮之前这条链路是断的：instance_nexus::SetData 处理了三个球体 entry，但**没有任何调用者**
# ——GameObject::Use 不通知副本脚本、球体没有 ScriptName、goober eventId 为 0。
# 已在 core 分支 codex/nexus-containment-sphere 补上 go_nexus_containment_sphere
# （OnGossipHello -> instance->SetData(entry) -> 通知她重算 CanRemovePrison），
# 并用 pending_db_world 的 rev_ SQL 绑定 ScriptName。
#
# 前置 = 另外三个 boss 的生成点；清完后框架使用三个球体（PrerequisiteGameObjects）。
# 核心的 GameObject::Use 仍会拒绝带 GO_FLAG_NOT_SELECTABLE 的球体（对应 boss 未死时），
# 所以进度门禁没有被绕过。
# 注意：本场景**不含**两组房前守卫（泰蕾斯特拉与奥莫洛克各 4 只），不是完整清本。
[Scenario]
MapId = 576
BossEntry = 26723
PartySize = 5
DungeonDifficulty = heroic
Strategy = wotlk-nex
RosterFile = "mod-raidtest-roster-normal5-v1.conf"
GearProfile = none
EngageX = 309.0
EngageY = -5.5
EngageZ = -15.48
EngageO = 3.14
TimeoutSeconds = 420
EngageTrigger = pull
# 完整顺序：泰蕾斯特拉的 4 只守卫 -> 泰蕾斯特拉 -> 阿诺姆鲁斯
#         -> 奥莫洛克的 4 只守卫 -> 奥莫洛克
# 只列三个 boss 是不够的（run377/383）：守卫不在列表里也会参战，第一场就变成
# 「boss + 4 精英」——run341 测过的 0/5 形态，两场分别 38.2 秒 1 死与 19.0 秒全灭。
# 按组排序还有一个好处：每组之间队伍会脱战，bot 自己就会喝水补蓝
# （mod-playerbots f0b090c6 修好了脱战吃喝的阈值）。
PrerequisiteSpawns = 126470,126465,126456,126464,126480,126599,126445,126444,126606,126605,126663
# 三个封印球体的生成点：Telestra's(65547) / Anomalus'(65548) / Ormorok's(65549)
PrerequisiteGameObjects = 65547,65548,65549
PreparationX = 509.0
PreparationY = 62.0
PreparationZ = -16.04
PreparationO = 4.71
PrerequisiteTimeoutSeconds = 1500

# 清怪控制链（2026-09-11，docs/testing/TRASH-CC-PULL-DESIGN.md）：准备点从 (519,110) 改到守卫西南 (509,62)
# ——(519,110) 距最近守卫 17 码在仇恨半径内，北侧走廊无视线，西北侧会让施法怪朝 boss 后撤。
# (509,62) 对四只守卫都有视线、距守卫 25.8 码、距泰蕾斯特拉 30.6 码（`raidtest los` 探针实测）。
PrerequisiteCcWaitSeconds = 25
# 链式里奥莫洛克的守卫组距他 17.1 码即协助参战；门禁只量到奥莫洛克(26794)——泰蕾斯特拉的守卫本来就站在她
# 18–22 码内且她不会协助，量「最近的 boss」会让第一组永远等不到开怪（run410 清怪 1500 秒超时）。
PrerequisiteMinBossDistance = 24.0
PrerequisiteMinBossDistanceBossEntry = 26794
